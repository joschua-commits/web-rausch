.chips label{display:block;font-weight:500}
.chips input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
.chips span,.chips button{display:block;font:500 14px var(--f-body);color:#1b1714;background:#fff;border:1.5px solid #e3ddd4;border-radius:12px;padding:10px 14px;cursor:pointer;text-align:left;transition:border-color .15s,background .15s}
.chips span:hover,.chips button:hover{border-color:#c9bfb3}
.chips input:checked+span{border-color:var(--orange);background:#fff1e5}
.chips input:focus-visible+span{outline:3px solid var(--orange);outline-offset:2px}
.c-result{display:flex;justify-content:space-between;align-items:baseline;gap:12px;background:#1b1714;color:#f4efe8;border-radius:16px;padding:16px 18px;margin-top:4px}
.c-result small{font:500 11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:#a59d93}
.c-result strong{font:800 clamp(20px,2.2vw,26px) var(--f-display);letter-spacing:-.02em;color:var(--ember);white-space:nowrap}
.app-btn{width:100%}
.app-btn:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
.app-done{font-size:14px;color:#1d6b43;background:#e3f4ea;border-radius:12px;padding:12px 14px}
.w-bar{height:4px;background:#e3ddd4;border-radius:2px;overflow:hidden}
.w-bar i{display:block;height:100%;width:0;background:var(--orange);transition:width .35s ease}
.w-q{order:-1;font:800 20px var(--f-display);letter-spacing:-.02em;margin-top:2px}
#wiz{grid-template-areas:"head" "bar" "q" "body"}
#wiz .app-head{grid-area:head}#wiz .w-bar{grid-area:bar}#wiz .w-q{grid-area:q;order:0}#wiz .w-step,#wiz .w-result{grid-area:body}
.w-sent{font-size:14px;color:#1d6b43;font-weight:600}
.w-note{background:#1b1714;color:#f4efe8;border-radius:18px;padding:14px 16px;display:grid;gap:4px;margin-top:10px}
.w-note .l-app{display:flex;align-items:center;gap:8px;font:500 12px var(--f-body);color:#a59d93}
.w-note .l-app small{margin-left:auto}
.w-note .l-icon{width:22px;height:22px;border-radius:6px;background:var(--orange);color:#000;display:grid;place-items:center;font-size:12px}
.w-note b{font-size:15px}
.w-note span{font-size:13px;color:#cfc7bd}
.w-again{background:none;border:0;cursor:pointer;font-size:14px;margin-top:14px;padding:0;color:#6b625a}
.days{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.days button,.slots button{font:600 14px var(--f-body);color:#1b1714;background:#fff;border:1.5px solid #e3ddd4;border-radius:12px;padding:9px 4px;cursor:pointer;display:grid;gap:2px;justify-items:center;transition:border-color .15s,background .15s}
.days button small{font:500 11px var(--f-mono);color:#8a8076}
.slots{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.days button[aria-pressed="true"],.slots button[aria-pressed="true"]{border-color:var(--orange);background:#fff1e5}
.slots button:disabled{color:#c2b9ae;text-decoration:line-through;cursor:not-allowed;background:#f1ede7}
.cal-entry{border-left:4px solid var(--orange);background:#fff;border-radius:10px;padding:12px 14px;display:grid;gap:2px;margin-top:10px}
.cal-entry span{font:500 12px var(--f-mono);color:var(--orange)}
.cal-entry small{color:#8a8076;font-size:13px}
.k-timer{display:flex;justify-content:space-between;align-items:baseline;background:#1b1714;color:#f4efe8;border-radius:16px;padding:18px}
.k-timer small{font-size:13px;color:#a59d93}
.k-timer strong{font:800 30px var(--f-display);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
#clock.on .k-timer small{color:var(--ok)}
#clock.on .app-btn{background:#1b1714;color:#f4efe8}
.k-list{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.k-list li{display:flex;justify-content:space-between;background:#fff;border:1px solid #e3ddd4;border-radius:10px;padding:10px 12px;font-size:14px}
.k-list li.new{border-color:var(--orange);background:#fff1e5}
.k-sum{display:flex;justify-content:space-between;font-weight:700;padding:0 4px}

/* 4 Branchen */
.trades{padding-block:clamp(70px,10vw,140px);border-top:1px solid var(--line)}
.trade-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:56px}
.trade{background:var(--bg2);border:1px solid var(--line);border-radius:24px;padding:24px;display:grid;gap:10px;align-content:start}
.trade h3{font-size:19px;font-weight:700;margin-bottom:6px}
.trade q{display:block;quotes:"„" "“";font-size:15px;color:#d9d2c8;background:#0e0d0c;border:1px solid var(--line);border-radius:12px;padding:10px 12px}
.trade p{font:500 12px/1.6 var(--f-mono);letter-spacing:.04em;color:var(--ember);margin-top:6px}
@media (max-width:980px){.trade-grid{grid-template-columns:1fr 1fr}}
@media (max-width:620px){.trade-grid{grid-template-columns:1fr}}

/* Preise schlicht */
.p-row{display:grid;grid-template-columns:repeat(3,1fr);margin-top:56px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.p-item{display:grid;gap:10px;padding:36px 28px 36px 0}
.p-item+.p-item{border-left:1px solid var(--line);padding-left:28px}
.p-item strong{font:900 clamp(40px,4.6vw,68px)/1 var(--f-display);letter-spacing:-.04em;white-space:nowrap}
.p-item:first-child strong{color:var(--orange)}
.p-item span{font:500 13px var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.p-note{margin-top:22px;color:var(--muted);font-size:14px}
@media (max-width:760px){.p-row{grid-template-columns:1fr}.p-item,.p-item+.p-item{border-left:0;padding:26px 0}.p-item+.p-item{border-top:1px solid var(--line)}}

/* Beispiel-Website (Dummy „Elektro Mustermann“) im Browser- und Handyrahmen */
.site-demo{position:relative;margin:48px 0 64px;padding-right:110px}
.sd-browser{border-radius:14px;overflow:hidden;border:1px solid var(--line);background:#1b1916;box-shadow:0 40px 90px -40px rgba(255,116,0,.35)}
.sd-bar{display:flex;align-items:center;gap:7px;padding:11px 14px;background:#1b1916;border-bottom:1px solid var(--line)}
.sd-bar i{width:11px;height:11px;border-radius:50%;background:#3a3530}
.sd-bar span{margin-left:12px;flex:1;max-width:340px;background:#0f0e0c;border-radius:7px;padding:5px 12px;font:500 12.5px/1.2 var(--f-mono);color:var(--muted)}
.sd-browser img{width:100%;height:auto}
.sd-phone{position:absolute;right:0;bottom:-40px;width:min(24%,230px);border-radius:30px;overflow:hidden;border:7px solid #1b1916;box-shadow:0 30px 70px -20px rgba(0,0,0,.8)}
.sd-phone img{width:100%;height:auto}
.site-demo figcaption{margin-top:62px;color:var(--muted);max-width:48em}
.site-demo figcaption b{display:block;color:var(--ink);font-size:19px;margin-bottom:4px}
@media (max-width:700px){.site-demo{padding-right:0}.sd-phone{width:32%;right:-4px;bottom:auto;top:46%;border-width:5px;border-radius:20px}.site-demo figcaption{margin-top:22px;padding-right:36%}.site-demo figcaption b{font-size:17px}}

/* Über mich + Werte direkt nach dem Hero */
.about-top{border-top:0}
.about-top .about-photo{width:clamp(180px,24vw,300px)}
.about-text{margin-top:22px;max-width:40em;color:var(--muted);font-size:clamp(17px,1.4vw,19px)}
.about-text p{margin:0 0 .7em}
.todo{background:#ffd23f;color:#000;padding:0 6px;border-radius:4px}
.werte{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:clamp(40px,6vw,70px)}
.werte div{border:1px solid var(--line);border-radius:18px;padding:24px 22px;background:var(--bg2)}
.werte span{display:block;font:500 12px/1 var(--f-mono);color:var(--orange);letter-spacing:.1em;margin-bottom:16px}
.werte b{display:block;color:var(--ink);font-size:18px;margin-bottom:6px}
.werte p{margin:0;color:var(--muted);font-size:15.5px;line-height:1.5}
@media (max-width:900px){.werte{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.werte{grid-template-columns:1fr}}
