/* 5 Ablauf als Zeitleiste */
.timeline{padding-block:clamp(90px,12vw,160px) clamp(60px,8vw,110px);border-top:1px solid var(--line)}
.tl{list-style:none;margin:64px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:28px;position:relative}
.tl::before,.tl::after{content:"";position:absolute;left:0;right:0;top:46px;height:1px;background:var(--line)}
.tl::after{background:var(--orange);transform:scaleX(0);transform-origin:left;transition:transform 1.6s cubic-bezier(.6,0,.2,1) .3s}
.tl.in::after{transform:scaleX(1)}
.tl li{display:grid;gap:12px;align-content:start;padding-right:10px}
.tl-day{font:500 12px var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);height:24px}
.tl-dot{width:14px;height:14px;border-radius:50%;background:var(--bg);border:1.5px solid #4a433b;position:relative;z-index:1;margin:2px 0 14px;transition:background .3s,border-color .3s,box-shadow .3s}
.tl.in li .tl-dot{background:var(--orange);border-color:var(--orange);box-shadow:0 0 0 6px rgba(255,116,0,.14)}
.tl.in li:nth-child(1) .tl-dot{transition-delay:.3s}.tl.in li:nth-child(2) .tl-dot{transition-delay:.75s}.tl.in li:nth-child(3) .tl-dot{transition-delay:1.2s}.tl.in li:nth-child(4) .tl-dot{transition-delay:1.65s}
.tl h3{font-size:clamp(19px,1.7vw,23px);font-weight:700}
.tl p{color:var(--muted);font-size:16px}
@media (max-width:860px){
  .tl{grid-template-columns:1fr;gap:34px;padding-left:34px}
  .tl::before,.tl::after{left:6px;right:auto;top:6px;bottom:6px;width:1px;height:auto}
  .tl::after{transform:scaleY(0);transform-origin:top}
  .tl.in::after{transform:scaleY(1)}
  .tl li{position:relative}
  .tl-dot{position:absolute;left:-34px;top:2px;margin:0}
  .tl-day{height:auto}
}

